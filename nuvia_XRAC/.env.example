# Copia este archivo como .env.local para desarrollo. Las variables VITE_* se
# incrustan en el código al compilar y son PÚBLICAS: no pongas secretos aquí.

# Fuente de los datos de pacientes y expedientes: 'mock' (datos de prueba, por defecto) | 'api'
VITE_DATA_SOURCE=mock

# Cada servicio puede conectarse por separado. Si no se indican, siguen a VITE_DATA_SOURCE.
# VITE_REPORTS_SOURCE=mock          # reportes, información adicional, borradores, confirmación, historial
# VITE_TRANSCRIPTION_SOURCE=mock    # transcripción de audio

# Dirección del backend vista desde el navegador (relativa o absoluta)
VITE_API_BASE_URL=/api

# Solo para `npm run dev`: a dónde reenvía Vite las peticiones a /api
# VITE_DEV_PROXY_TARGET=http://localhost:8000

# VITE_REQUEST_TIMEOUT_MS=15000
# VITE_GENERATION_TIMEOUT_MS=120000   # generar reporte / transcribir
# VITE_MAX_AUDIO_MB=25
